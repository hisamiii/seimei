{
  "manifest_version": 3,
  "name": "seimei",
  "version": "1.1.0",
  "description": "Lets seimei on this computer list, read, open, switch and close tabs, act on pages, take tab screenshots and start downloads.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "webNavigation",
    "webRequest",
    "nativeMessaging",
    "downloads",
    "scripting",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
