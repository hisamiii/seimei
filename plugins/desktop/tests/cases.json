{
 "about": "The desktop plugin on fakes: no compositor, a fake niri socket and fake command line tools (tests/fakes here), input devices writing to a file. {home} is the test's HOME. checks: the card a desktop tool call needs (null: none), with ours the windows seimei opened, and no window manager running, so a close names no window. layout_command, layout_describe: how a remembered window starts again and how a restore card lists them. keys: the input events (type, code, value; each call ends with a sync) a device sends. niri: tool calls and checks against a fake niri with this state; log is what the fake tools were run with, keys what the input devices sent.",
 "checks": [
  {"backend": "niri", "tool": "mcp__desktop__niri", "input": {"action": "quit"}, "want": {"action": "desktop", "target": "quit niri (ends the desktop session)", "detail": "niri msg action quit"}},
  {"backend": "niri", "tool": "mcp__desktop__niri", "input": {"action": "close-window", "args": ["--id", "7"]}, "ours": [7], "want": null},
  {"backend": "niri", "tool": "mcp__desktop__niri", "input": {"action": "close-window", "args": ["--id", "9"]}, "ours": [7], "want": {"action": "desktop", "target": "close a window", "detail": "niri msg action close-window --id 9"}},
  {"backend": "niri", "tool": "mcp__desktop__niri", "input": {"action": "close-window"}, "want": {"action": "desktop", "target": "close a window", "detail": "niri msg action close-window"}},
  {"backend": "niri", "tool": "mcp__desktop__niri", "input": {"action": "focus-window", "args": ["--id", "9"]}, "want": null},
  {"backend": "niri", "tool": "mcp__desktop__sway", "input": {"action": "exit"}, "want": null},
  {"backend": "sway", "tool": "mcp__desktop__sway", "input": {"action": "exit"}, "want": {"action": "desktop", "target": "exit sway (ends the desktop session)", "detail": "swaymsg exit"}},
  {"backend": "sway", "tool": "mcp__desktop__sway", "input": {"action": "[con_id=5]", "args": ["kill"]}, "ours": [5], "want": null},
  {"backend": "sway", "tool": "mcp__desktop__sway", "input": {"action": "[con_id=6]", "args": ["kill"]}, "want": {"action": "desktop", "target": "close a window", "detail": "swaymsg [con_id=6] kill"}},
  {"backend": "hyprland", "tool": "mcp__desktop__hyprland", "input": {"action": "exit"}, "want": {"action": "desktop", "target": "exit Hyprland (ends the desktop session)", "detail": "hyprctl dispatch exit"}},
  {"backend": "hyprland", "tool": "mcp__desktop__hyprland", "input": {"action": "closewindow", "args": ["address:0x5"]}, "ours": [5], "want": null},
  {"backend": "hyprland", "tool": "mcp__desktop__hyprland", "input": {"action": "workspace", "args": ["2"]}, "want": null},
  {"backend": "niri", "tool": "mcp__desktop__niri", "input": {"action": "spawn", "args": ["--", "niri", "msg", "action", "quit"]}, "want": {"action": "desktop", "target": "run -- niri msg action quit on your desktop", "detail": "niri msg action spawn -- niri msg action quit"}},
  {"backend": "niri", "tool": "mcp__desktop__niri", "input": {"action": "close-window", "args": "--id 7"}, "ours": [7], "want": {"action": "desktop", "target": "close a window", "detail": "niri msg action close-window"}},
  {"backend": "sway", "tool": "mcp__desktop__sway", "input": {"action": "exec", "args": ["'swaymsg exit'"]}, "want": {"action": "desktop", "target": "run exec 'swaymsg exit' on your desktop", "detail": "swaymsg exec 'swaymsg exit'"}},
  {"backend": "hyprland", "tool": "mcp__desktop__hyprland", "input": {"action": "exec", "args": ["hyprctl dispatch exit"]}, "want": {"action": "desktop", "target": "run hyprctl dispatch exit on your desktop", "detail": "hyprctl dispatch exec hyprctl dispatch exit"}},
  {"backend": "x11", "tool": "mcp__desktop__x11", "input": {"action": "exec", "args": ["xkill"]}, "want": {"action": "desktop", "target": "run xkill on your desktop", "detail": "xdotool exec xkill"}},
  {"backend": "x11", "tool": "mcp__desktop__x11", "input": {"action": "windowclose", "args": ["12"]}, "ours": [12], "want": null},
  {"backend": "x11", "tool": "mcp__desktop__x11", "input": {"action": "windowclose", "args": ["13"]}, "ours": [12], "want": {"action": "desktop", "target": "close a window", "detail": "xdotool windowclose 13"}},
  {"backend": "x11", "tool": "mcp__desktop__x11", "input": {"action": "key", "args": ["ctrl+t"]}, "want": null},
  {"backend": "kde", "tool": "mcp__desktop__kde", "input": {"action": "quit"}, "want": null}
 ],
 "layout_command": [
  {"rec": {"app_id": "firefox", "argv": ["/usr/lib/firefox/firefox", "--new-window", "https://x.org"]}, "shell": "fish", "want": "/usr/lib/firefox/firefox"},
  {"rec": {"app_id": "anki", "argv": ["/usr/bin/python3", "/usr/bin/anki", "-p", "me"]}, "shell": "fish", "want": "/usr/bin/python3 /usr/bin/anki"},
  {"rec": {"app_id": "vesktop", "argv": ["electron", "/usr/lib/vesktop/app.asar", "--x"]}, "shell": "fish", "want": "electron /usr/lib/vesktop/app.asar"},
  {"rec": {"app_id": "odd", "argv": ["/opt/my app/run it", "a b"]}, "shell": "fish", "want": "'/opt/my app/run it'"},
  {"rec": {"app_id": "gone", "argv": []}, "shell": "fish", "want": null},
  {"rec": {"app_id": "kitty", "cwd": "/srv/my code", "argv": ["kitty"]}, "shell": "fish", "want": "kitty -d '/srv/my code'"},
  {"rec": {"app_id": "kitty", "cwd": null, "argv": ["kitty"]}, "shell": "zsh", "want": "kitty -d {home}"},
  {"rec": {"app_id": "kitty", "cwd": "/tmp", "argv": ["kitty"], "claude": {"session_id": "0b8d7f8e-1111-2222-3333-444455556666", "cwd": "/home/me/src/it's", "name": "fix", "args": ["--model", "opus"]}}, "shell": "fish", "want": "kitty -d \"/home/me/src/it's\" fish -c 'claude --model opus --resume 0b8d7f8e-1111-2222-3333-444455556666; exec fish'"},
  {"rec": {"app_id": "kitty", "cwd": "/tmp", "argv": ["kitty"], "claude": {"session_id": "abc", "cwd": null, "name": null, "args": []}}, "shell": "bash", "want": "kitty -d /tmp bash -c 'claude --resume abc; exec bash'"}
 ],
 "layout_describe": [
  {"plan": [], "want": ""},
  {"plan": [{"app_id": "firefox", "workspace": 1}, {"app_id": "kitty", "workspace": 2, "claude": {"session_id": "0b8d7f8e-1111-2222", "name": null}}, {"app_id": "kitty", "workspace": null, "claude": {"session_id": "x", "name": "fix the build"}}], "want": "workspace 1: firefox\nworkspace 2: resume Claude session \"0b8d7f8e\"\nworkspace ?: resume Claude session \"fix the build\""}
 ],
