{
  "manifest_version": 2,
  "name": "seimei",
  "version": "1.0.0",
  "description": "Lets seimei on this laptop list, read, open, switch and close tabs and start downloads.",
  "browser_specific_settings": {"gecko": {"id": "seimei@localhost", "strict_min_version": "115.0"}},
  "permissions": ["tabs", "nativeMessaging", "downloads", "<all_urls>"],
  "background": {"scripts": ["background.js"], "persistent": true},
  "icons": {"48": "icon.svg", "96": "icon.svg"}
}
