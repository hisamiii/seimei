[Unit]
Description=seimei, the phone-driven dispatcher
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/.local/share/seimei-app
# deploy.sh syncs the venv; uv in between would hand python a second SIGTERM on stop.
ExecStart=%h/.local/share/seimei-app/.venv/bin/python -m seimei
# seimei closes its own Claude sessions; anything left gets SIGKILL after it exits.
KillMode=mixed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
