[Unit]
Description=seimei, the phone-driven dispatcher
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/.local/share/seimei-app
# deploy.sh builds the binary in the production checkout and swaps it in by rename right before the restart.
ExecStart=%h/.local/share/seimei-app/bin/seimei serve
# seimei closes its own Claude sessions; anything left gets SIGKILL after it exits.
KillMode=mixed
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
